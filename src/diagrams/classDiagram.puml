@startuml
'https://plantuml.com/class-diagram

title Træningscenter – løsning med relationer

skinparam classAttributeIconSize 0
hide empty members

class Main {
    + {static} main(String[] args) : void
}

class UI {
    - scanner : Scanner
    - center : FitnessCenter
    + UI(FitnessCenter center, Scanner scanner)
    + run() : void
    - printMenu() : void
    - showAllMembers() : void
    - showAllSessions() : void
    - showAvailableSessions() : void
    - createMember() : void
    - createSession() : void
    - bookSession() : void
    - cancelBooking() : void
    - showBookings() : void
    - findMember(int memberId) : Member
    - findSession(String title) : TrainingSession
    - readInt(String prompt) : int
    - readText(String prompt) : String
}

class Scanner <<java.util>>

class FitnessCenter {
    - name : String
    - members : ArrayList<Member>
    - sessions : ArrayList<TrainingSession>
    + FitnessCenter(String name)
    + getName() : String
    + addMember(Member member) : boolean
    + addSession(TrainingSession session) : boolean
    + findMember(int memberId) : Member
    + findSession(String title) : TrainingSession
    + bookSession(Member member, TrainingSession session) : boolean
    + cancelBooking(Member member, TrainingSession session) : boolean
    + printAllMembers() : void
    + printAllSessions() : void
    + printAvailableSessions() : void
}

abstract class Member {
    - name : String
    - memberId : int
    - bookings : ArrayList<Booking>
    + Member(String name, int memberId)
    + getName() : String
    + getMemberId() : int
    + addBooking(Booking booking) : void
    + printBookings() : void
    + getActiveBookingCount() : int
    + findActiveBooking(TrainingSession session) : Booking
    + hasBooked(TrainingSession session) : boolean
    + hasReachedMaxBookings() : boolean
    + getMembershipType() : String
    + printMember() : void
    + {abstract} getMaxBookings() : int
    + {abstract} getMonthlyPrice() : double
}

class BasicMember {
    + BasicMember(String name, int memberId)
    + getMaxBookings() : int
    + getMonthlyPrice() : double
}

class PremiumMember {
    + PremiumMember(String name, int memberId)
    + getMaxBookings() : int
    + getMonthlyPrice() : double
}

class TrainingSession {
    - title : String
    - instructor : String
    - capacity : int
    - participants : ArrayList<Member>
    + TrainingSession(String title, String instructor, int capacity)
    + getTitle() : String
    + getInstructor() : String
    + getCapacity() : int
    + addParticipant(Member member) : boolean
    + removeParticipant(Member member) : boolean
    + hasAvailableSpace() : boolean
    + getAvailableSpaces() : int
    + printSession() : void
}

class Booking {
    - member : Member
    - trainingSession : TrainingSession
    - active : boolean
    + Booking(Member member, TrainingSession trainingSession)
    + getMember() : Member
    + getTrainingSession() : TrainingSession
    + cancel() : void
    + isActive() : boolean
    + printBooking() : void
}

' ---------- IS-A (nedarving) ----------
Member <|-- BasicMember : IS-A
Member <|-- PremiumMember : IS-A

' ---------- HAS-A (komposition) ----------
UI "1" --> "1" FitnessCenter : HAS-A center
UI "1" --> "1" Scanner : HAS-A scanner
FitnessCenter "1" o-- "0..*" Member : HAS-A members
FitnessCenter "1" o-- "0..*" TrainingSession : HAS-A sessions
Member "1" o-- "0..*" Booking : HAS-A bookings
Booking "0..*" --> "1" Member : HAS-A member
Booking "0..*" --> "1" TrainingSession : HAS-A trainingSession
TrainingSession "0..*" o-- "0..*" Member : HAS-A participants

' ---------- Hvem opretter objekterne ----------
Main ..> UI : creates
Main ..> FitnessCenter : creates
Main ..> BasicMember : creates
Main ..> PremiumMember : creates
Main ..> TrainingSession : creates
UI ..> BasicMember : creates
UI ..> PremiumMember : creates
UI ..> TrainingSession : creates
FitnessCenter ..> Booking : creates

legend right
  Hul trekant: IS-A (nedarving med extends)
  Hul diamant: HAS-A (en liste af objekter som felt)
  Fuld pil: HAS-A (én reference som felt)
  Stiplet pil: creates (opretter objekter med new)
endlegend

@enduml
